<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-area"
            stylesheets="@../styles/styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.GuideDashboardController">

    <VBox spacing="20.0">
        <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
        </padding>

        <VBox spacing="4.0">
            <Label fx:id="pageTitle" styleClass="page-title" text="Welcome back" />
            <Label styleClass="page-subtitle" text="Dashboard" />
        </VBox>

        <HBox spacing="16.0">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="Tours This Week" />
                <Label fx:id="toursThisWeekValue" styleClass="stat-value" text="—" />
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="Customers" />
                <Label fx:id="customersValue" styleClass="stat-value" text="—" />
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="Completed Tours" />
                <Label fx:id="completedToursValue" styleClass="stat-value" text="—" />
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="Next Tour" />
                <Label fx:id="nextTourValue" styleClass="stat-value-sm" text="—" />
            </VBox>
        </HBox>

        <VBox styleClass="panel" spacing="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT">
                <Label styleClass="panel-title" text="Today's Tour" />
            </HBox>
            <TableView fx:id="todayTourTable" styleClass="table-view"
                       prefHeight="80.0" fixedCellSize="42.0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colTodayDate" text="Date" prefWidth="100.0" minWidth="100.0" />
                    <TableColumn fx:id="colTodayTourName" text="Tour Name" prefWidth="170.0" minWidth="170.0" />
                    <TableColumn fx:id="colTodayDestination" text="Destination" prefWidth="150.0" minWidth="150.0" />
                    <TableColumn fx:id="colTodayHotel" text="Hotel" prefWidth="150.0" minWidth="150.0" />
                    <TableColumn fx:id="colTodayGroupSize" text="Group" prefWidth="80.0" minWidth="80.0" />
                    <TableColumn fx:id="colTodayVehicle" text="Vehicle" prefWidth="120.0" minWidth="120.0" />
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="panel" spacing="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT">
                <Label styleClass="panel-title" text="Upcoming Tours" />
            </HBox>
            <TableView fx:id="upcomingToursTable" styleClass="table-view"
                       prefHeight="220.0" fixedCellSize="42.0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100.0" minWidth="100.0" />
                    <TableColumn fx:id="colTourName" text="Tour Name" prefWidth="170.0" minWidth="170.0" />
                    <TableColumn fx:id="colDestination" text="Destination" prefWidth="150.0" minWidth="150.0" />
                    <TableColumn fx:id="colHotel" text="Hotel" prefWidth="150.0" minWidth="150.0" />
                    <TableColumn fx:id="colGroupSize" text="Group" prefWidth="80.0" minWidth="80.0" />
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
