<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="content-area"
            stylesheets="@../styles/styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.RouteManagementController">

    <VBox spacing="20.0">
        <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="page-title" text="Route Management" />
                <Label styleClass="page-subtitle" text="Manage travel routes" />
            </VBox>
            <Button styleClass="btn-primary" text="+ Add Route" onAction="#onAddRoute" />
        </HBox>

        <HBox spacing="16.0">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-label" text="Total Routes" />
                <Label fx:id="totalRoutesValue" styleClass="stat-value" text="—" />
            </VBox>
        </HBox>

        <VBox styleClass="panel" spacing="0">
            <HBox styleClass="panel-header" alignment="CENTER_LEFT">
                <Label styleClass="panel-title" text="All Routes" />
            </HBox>
            <TableView fx:id="routesTable" styleClass="table-view"
                       prefHeight="400.0" fixedCellSize="42.0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colRouteName"  text="Route Name"     prefWidth="180.0" minWidth="140.0" />
                    <TableColumn fx:id="colStartCity"  text="Start City"     prefWidth="130.0" minWidth="100.0" />
                    <TableColumn fx:id="colEndCity"    text="End City"       prefWidth="130.0" minWidth="100.0" />
                    <TableColumn fx:id="colCountry"    text="Country"        prefWidth="110.0" minWidth="90.0" />
                    <TableColumn fx:id="colDistance"   text="Distance (km)"  prefWidth="110.0" minWidth="90.0" />
                    <TableColumn fx:id="colBasePrice"  text="Base Price (€)" prefWidth="110.0" minWidth="90.0" />
                    <TableColumn fx:id="colActions"    text="Actions"        prefWidth="100.0" minWidth="90.0" sortable="false" />
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
